# Copy this file to .env for local development (never commit .env).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-this-dev-secret-in-local-env
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://127.0.0.1:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Local MySQL / XAMPP MariaDB connection (adjust user/password/port as needed):
DATABASE_URL="mysql://root:@127.0.0.1:3306/buildguard?charset=utf8mb4"
###< doctrine/doctrine-bundle ###
